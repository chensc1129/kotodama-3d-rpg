[gd_resource type="Theme" load_steps=5 format=3]

[ext_resource type="FontFile" path="res://assets/fonts/noto_cjk_game.otf" id="1_cjk"]
[ext_resource type="FontFile" path="res://assets/fonts/noto_emoji_game.ttf" id="2_emoji"]

[sub_resource type="SystemFont" id="SystemFont_cjk"]
font_names = PackedStringArray("Noto Sans TC", "Noto Sans JP", "Noto Sans CJK TC", "Noto Sans CJK JP", "Microsoft JhengHei", "PingFang TC", "Hiragino Sans", "WenQuanYi Micro Hei", "Sans-Serif")
subpixel_positioning = 1

[sub_resource type="FontVariation" id="FontVariation_main"]
base_font = ExtResource("1_cjk")
fallbacks = [ExtResource("2_emoji"), SubResource("SystemFont_cjk")]

[resource]
default_font = SubResource("FontVariation_main")
default_font_size = 15
